{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": ["string", "null"],
      "description": "清洗后的商品标题"
    },
    "remove_image_urls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string" },
          "reason": { "type": "string" },
          "confidence": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "required": ["url", "reason", "confidence"]
      }
    },
    "category": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "category_ids": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 3
        },
        "category_path": { "type": "string" },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reason": { "type": "string" }
      },
      "required": ["category_ids", "category_path", "confidence", "reason"]
    },
    "ai_attr_suggestions": {
      "type": "object",
      "description": "补齐的微信类目必填属性，key 为属性名，value 为属性值。销售属性（如尺码/颜色）的值用分号分隔多个 SKU 值",
      "additionalProperties": { "type": "string" }
    },
    "needs_human_review": { "type": "boolean" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 }
  },
  "required": [
    "title",
    "remove_image_urls",
    "category",
    "ai_attr_suggestions",
    "needs_human_review",
    "notes",
    "confidence"
  ]
}
